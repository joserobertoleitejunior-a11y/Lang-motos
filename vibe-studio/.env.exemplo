# Copie para a área de variáveis da hospedagem (Railway/Render). NUNCA coloque este arquivo com valores reais no GitHub.

# Obrigatória: a senha para entrar no app (use 12+ caracteres)
SENHA_APP=

# Opcionais (o servidor cria sozinho se ficarem vazias e guarda no disco /data)
SEGREDO_SESSAO=
SEGREDO_CHAVES=

# Chaves das IAs (opcional aqui: você também pode colar pelo app em Ajustes)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
FAL_KEY=

# Ajustes finos (opcionais)
MODELO_CLAUDE=claude-opus-5-5
ESFORCO_CLAUDE=medium
LIMITE_CUSTO_VIDEO_USD=3
LIMITE_CUSTO_MES_USD=60
RENDER_CONCORRENCIA=2
DATA_DIR=/data
