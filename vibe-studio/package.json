{
  "name": "vibe-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Vibe Studio — plataforma de vídeos com IA (roteiro, voz, imagens, animação e render).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "servidor": "tsx watch src/server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "verificar": "tsc --noEmit -p .",
    "demo": "tsx scripts/renderizar.ts video demo 9:16",
    "audio": "python3 scripts/gerar_audio.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/multipart": "9.2.1",
    "@fastify/static": "8.2.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "@remotion/layout-utils": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/media-utils": "4.0.541",
    "@remotion/player": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "fastify": "5.6.1",
    "fflate": "0.8.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.541",
    "tsx": "4.20.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
